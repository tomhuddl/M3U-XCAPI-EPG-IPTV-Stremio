# Example environment configuration for IPTV Stremio Addon

# Port to run the HTTP server on
PORT=7000

# Persistent volume mount path; attach a durable volume at this path in the host.
# PERSISTENT_DATA_DIR=/data
PERSISTENT_DATA_MAX_BYTES=134217728
PERSISTENT_CACHE_RETENTION_DAYS=90

# Provider catalogue and EPG refresh interval (default 12 hours)
DATA_REFRESH_INTERVAL_MS=43200000

# Large provider-side section drops and emptied sections need a matching refresh confirmation.
PROVIDER_REMOVAL_GUARD_MIN_ITEMS=10
PROVIDER_REMOVAL_GUARD_PERCENT=25
PROVIDER_REMOVAL_CONFIRMATIONS=2

# Enable/disable the provider-data LRU and Redis layers (true/false).
# Refresh scheduling, the addon-interface cache, and configured disk persistence stay enabled.
CACHE_ENABLED=true

# TTL (ms) for provider-data LRU (default 6 hours)
CACHE_TTL_MS=21600000

# Provider-data LRU limits
MAX_CACHE_ENTRIES=10
CACHE_MEMORY_MAX_BYTES=268435456

# Bounded addon-interface cache (kept alive for refresh jobs until evicted)
MAX_INTERFACE_CACHE_ENTRIES=3
INTERFACE_CACHE_MAX_BYTES=268435456
INTERFACE_CACHE_TTL_MS=0

# Limit concurrent provider/addon builds (default 2, max 8).
MAX_ACTIVE_INTERFACE_BUILDS=2

# Includes cached and draining interfaces, preventing a public setup workload
# from accumulating unlimited instances while older work finishes.
MAX_LIVE_ADDON_INTERFACES=6

# Total shutdown budget. Railway configuration and Compose allow 30 seconds.
SHUTDOWN_TIMEOUT_MS=15000

# Process EPG sources in configured order for deterministic retention priority.
# Values 2-4 allow parallel source parsing, sharing the same aggregate cap.
EPG_FETCH_CONCURRENCY=1

# Optional Redis URL for shared caching (comment out to disable Redis)
# REDIS_URL=redis://localhost:6379/0

# Required for the configuration UI to create encrypted tokens (minimum 16 characters; use a long random value).
# Set a unique, randomly generated secret in your host's environment settings.
# Generate a unique random secret (prefer 32+ random bytes) and keep it private.
# Existing encrypted tokens require the same CONFIG_SECRET to decrypt.
# CONFIG_SECRET=replace_with_a_long_random_secret

# Optional migration switch for OLD plaintext Base64 tokens only.
# Keep false/unset unless you need to migrate old links; these tokens are not secure.
ALLOW_LEGACY_CONFIG_TOKENS=false

# Optional owner-only setup access. Existing installed addon tokens still work.
# Leave unset for a public configuration service; use HTTPS when enabling it.
# SETUP_USERNAME=admin
# SETUP_PASSWORD=set_a_unique_random_password_of_at_least_16_characters

# Limit concurrent server-side prefetches (default 2, max 8).
PREFETCH_MAX_CONCURRENT=2

# Maximum bytes read from provider / playlist / EPG responses (default 50 MB; hard cap 150 MB).
PROVIDER_MAX_BYTES=50000000

# Maximum bytes returned from /api/prefetch (default 50 MB; hard cap 150 MB).
PREFETCH_MAX_BYTES=50000000

# Maximum bytes accepted by XMLTV streaming and /api/epg-stats (default/hard cap 150 MB).
EPG_MAX_BYTES=150000000

# Per-IP requests per minute for tokenized addon routes (default 1200; process-local).
ADDON_REQUEST_RATE_MAX=1200

# Per-IP setup/preflight and /encrypt requests per minute (default 120).
PREFLIGHT_RATE_MAX=120

# Minimum log detail: debug, info (default), warn, or error.
LOG_LEVEL=info

# Enable concise debug diagnostics regardless of LOG_LEVEL (true/false)
DEBUG_MODE=false

# Retry incomplete provider/TMDb/OMDb catalogue metadata after 12 hours; complete entries keep the 14-day refresh.
OMDB_MISSING_DATA_RETRY_MS=43200000

# Retry a failed normal refresh of otherwise-complete metadata after 12 hours.
CATALOG_METADATA_FAILURE_RETRY_MS=43200000

# Persist OMDb daily quota in blocks to reduce mounted-volume writes.
OMDB_DAILY_RESERVATION_BLOCK_SIZE=25

# Match this to your actual OMDb account allowance. The counter is local to one
# process/volume; clearing it does not reset the account's real usage.
# OMDB_DAILY_REQUEST_LIMIT=100000

# Bound the in-memory set of retryable OMDb lookup failures.
OMDB_RETRY_FAILURE_MAX_ENTRIES=10000
